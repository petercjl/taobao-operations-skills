{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "sycm-item-rank-helper",
  "target_platforms": [
    "codex",
    "sealseek"
  ],
  "dependencies": [
    {
      "name": "sycmcli",
      "package": "@petercjl/sycmcli",
      "minimum_version": "0.4.0",
      "resolution": "advertised skill catalog or sycmcli skill source --json",
      "required_capabilities": [
        "business.registered_data.read"
      ]
    }
  ],
  "capabilities": [
    {
      "id": "item.data.route",
      "purpose": "Route natural-language item ranking and item-detail requests to stable sycmcli read commands and return traceable data.",
      "required": true,
      "required_features": [
        "dependency-resolution",
        "intent-routing",
        "store-binding",
        "complete-pagination",
        "explicit-sort",
        "output-identity-validation",
        "null-preservation"
      ],
      "input_fields": [
        "store",
        "queryType",
        "dateType",
        "dateRange",
        "itemId",
        "orderBy",
        "topN"
      ],
      "output_fields": [
        "queryType",
        "recordCount",
        "returnedCount",
        "complete",
        "items",
        "metrics",
        "modules",
        "sourceCommands",
        "dataGaps"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "read-only-selected-store"
      }
    }
  ]
}
