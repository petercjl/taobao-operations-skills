{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "competitor-shop-analysis",
  "target_platforms": [
    "codex",
    "sealseek"
  ],
  "dependencies": [
    {
      "name": "sycmcli",
      "package": "@petercjl/sycmcli",
      "minimum_version": "0.4.0",
      "resolution": "advertised skill catalog or sycmcli skill source --json",
      "required_capabilities": [
        "business.registered_data.read"
      ]
    }
  ],
  "capabilities": [
    {
      "id": "competitor.shop.compare",
      "purpose": "Compare monitored competitor shops across core metrics, trends, traffic, keywords, audiences, products, and observed operations.",
      "required": true,
      "required_features": [
        "registered-operation-only",
        "explicit-competitor-selection",
        "period-alignment",
        "metric-alignment",
        "range-preservation",
        "evidence-linked-actions"
      ],
      "input_fields": [
        "store",
        "sellerIds",
        "dateRange",
        "focus"
      ],
      "output_fields": [
        "coreComparison",
        "trendComparison",
        "trafficComparison",
        "searchWordComparison",
        "audienceComparison",
        "topItemComparison",
        "operationEvidence",
        "actions",
        "dataGaps"
      ],
      "side_effects": {
        "external_mutation": false,
        "may_cost_money": false,
        "authorization": "read-only-selected-store"
      }
    }
  ]
}
