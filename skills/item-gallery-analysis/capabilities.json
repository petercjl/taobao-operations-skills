{
  "schema": "portable-skill-capabilities",
  "schema_version": "1.0.0",
  "skill": "item-gallery-analysis",
  "target_platforms": ["codex", "sealseek"],
  "dependencies": [
    {
      "name": "sycmcli",
      "package": "@petercjl/sycmcli",
      "minimum_version": "0.4.0",
      "resolution": "advertised skill catalog or sycmcli skill source --json",
      "required_capabilities": ["sycm.item.gallery.read"]
    }
  ],
  "capabilities": [
    {
      "id": "item.gallery-performance.analyze",
      "purpose": "Analyze one item's image and video material exposure, interaction, payment, conversion, and loss performance without inventing visual-content causes.",
      "required": true,
      "required_features": ["dependency-resolution", "store-and-item-binding", "complete-pagination", "material-type-grouping", "sample-size-gate", "null-preservation", "non-additive-metric-warning", "evidence-linked-actions"],
      "input_fields": ["store", "itemId", "dateType", "dateRange", "contentType", "limit"],
      "output_fields": ["store", "itemId", "dateRange", "completeness", "typeSummary", "materials", "topExposure", "highConversion", "highLoss", "actions", "dataGaps"],
      "side_effects": {"external_mutation": false, "may_cost_money": false, "authorization": "read-only-selected-store"}
    }
  ]
}
